{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Share",
  "version": "1.0.2",
  "identifier": "cn.sommo.lan-share",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LAN Share",
        "width": 980,
        "height": 650,
        "minWidth": 980,
        "minHeight": 650,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
